# =======================================================
# HABITAT DISCIPLINE PLATFORM - ENVIRONMENT CONFIGURATION
# =======================================================

# App Environment (development | staging | production)
APP_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WS_URL=ws://localhost:4000/ws

# PostgreSQL Database Connection
DATABASE_URL=postgresql://habitat_admin:discipline_pass_2026@localhost:5432/habitat_db?schema=public

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379

# JWT Secret Key
JWT_SECRET=habitat_super_secure_jwt_secret_key_change_in_production_2026

# MinIO / AWS S3 Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=habitat-proofs
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# Push Notifications (APNs / FCM)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
