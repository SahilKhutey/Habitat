{
  "openapi": "3.0.3",
  "info": {
    "title": "Discipline Platform REST API",
    "version": "0.1.0",
    "description": "Authoritative Discipline, Alarm, Mission, Proof, and Gamification API Gateway."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns system health, database status, and API version.",
        "responses": {
          "200": {
            "description": "System operational"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "User Registration",
        "description": "Registers a new user account with initial 100 XP starting bonus.",
        "responses": {
          "201": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Task Catalog",
        "description": "Retrieves the catalog of starter and custom discipline tasks.",
        "responses": {
          "200": {
            "description": "Task list retrieved"
          }
        }
      }
    },
    "/alarms": {
      "get": {
        "summary": "User Alarms",
        "description": "Retrieves active alarm commitments for a user.",
        "responses": {
          "200": {
            "description": "Alarms list"
          }
        }
      }
    },
    "/missions/trigger": {
      "post": {
        "summary": "Trigger Mission",
        "description": "Activates a scheduled mission when an alarm fires.",
        "responses": {
          "201": {
            "description": "Mission triggered"
          }
        }
      }
    },
    "/proofs/verify": {
      "post": {
        "summary": "Verify Proof",
        "description": "Validates photo/video proof with anti-cheat heuristics and settles XP ledger.",
        "responses": {
          "200": {
            "description": "Verification result"
          }
        }
      }
    },
    "/gamification/overview": {
      "get": {
        "summary": "Gamification Overview",
        "description": "Retrieves user total XP, current streak, and grace tokens.",
        "responses": {
          "200": {
            "description": "Gamification status"
          }
        }
      }
    }
  }
}
