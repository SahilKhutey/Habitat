{
  "name": "habitat-backend",
  "version": "1.0.0",
  "description": "Habitat: Mission-Driven Discipline Platform - Modular TypeScript & Express Backend Core",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/main.ts",
    "dev": "ts-node src/main.ts",
    "test": "vitest run",
    "test:vision:real": "vitest run tests/real_vision_adversarial_matrix.test.ts",
    "verify:no-production-mocks": "node scripts/verify-no-production-mocks.mjs",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@prisma/client": "^6.4.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "prisma": {
      "deepmerge-ts": "^8.0.0",
      "@prisma/config": {
        "deepmerge-ts": "^8.0.0"
      }
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
